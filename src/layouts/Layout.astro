---
import '../styles/global.css';
const { title = 'Wandertrex — Travel Website' } = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <script is:inline>document.documentElement.classList.add("js")</script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Monsieur+La+Doulaise&display=swap" rel="stylesheet" />
</head>
<body class="overflow-x-clip bg-cream font-sans text-forest antialiased selection:bg-forest selection:text-cream">
  <slot />
  <script>import "../scripts/motion.ts";</script>
</body>
</html>
