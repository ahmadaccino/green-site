<header id="top" class="relative isolate h-[max(100svh,62.5vw)] min-h-[640px] overflow-hidden bg-[#2a3627] text-cream">
  <img
    src="https://images.unsplash.com/photo-1529899788567-af6f475f1416?auto=format&fit=crop&w=2400&q=80"
    alt="Swan pedal boat on a lake in front of a forest"
    class="absolute inset-0 -z-10 size-full origin-[31%_100%] scale-[1.6] object-cover object-bottom"
  />
  <!-- grade the photo into the design's dark moss greens -->
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(180deg,#5d634b_0%,#8a855c_30%,#9a9262_55%,#8a8660_62%,#6e6e59_68%,#6b6b56_100%)] mix-blend-multiply"></div>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(26,34,24,.45),transparent_28%,transparent_72%,rgba(26,34,24,.3))]"></div>

  <nav class="grid grid-cols-[1fr_auto_1fr] items-center px-5 pt-8 md:px-10 md:pt-[50px]">
    <ul class="hidden items-center gap-[17px] text-[15px] lg:flex">
      <li><a href="#top" class="text-cream">Home</a></li>
      <li><a href="#about" class="text-cream/55 transition-colors hover:text-cream">About Us</a></li>
      <li><a href="#destinations" class="text-cream/55 transition-colors hover:text-cream">Destinations</a></li>
      <li><a href="#destinations" class="text-cream/55 transition-colors hover:text-cream">Packages</a></li>
      <li><a href="#testimonials" class="text-cream/55 transition-colors hover:text-cream">Travel Tips</a></li>
    </ul>
    <a href="#top" class="col-start-1 justify-self-start text-[20px] tracking-[-.01em] md:text-[23px] lg:col-start-2 lg:justify-self-center">Wandertrex</a>
    <div class="col-start-3 flex items-center gap-[18px] justify-self-end text-[15px]">
      <a href="#contact" class="hidden transition-opacity hover:opacity-70 sm:block">Contact Us</a>
      <a href="#" class="grid h-[31px] place-items-center rounded-full border border-cream/90 px-[25px] transition-colors hover:bg-cream hover:text-pine">Log In</a>
    </div>
  </nav>

  <div class="absolute inset-0 flex items-center justify-center px-5 pb-6">
    <div class="relative text-[max(52px,6.67vw)] leading-none">
      <span class="absolute right-full top-[.59em] mr-[.2em] hidden h-px w-[1.83em] bg-linear-to-r from-cream/0 to-cream/55 md:block"></span>
      <h1 class="whitespace-nowrap italic tracking-[-.03em]"><span class="swash -mr-[.24em] text-[1.5em]">A</span>reumdaum</h1>
      <span class="absolute left-full top-[.59em] ml-[.3em] hidden h-px w-[1.78em] bg-linear-to-l from-cream/0 to-cream/55 md:block"></span>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0">
    <div class="grid grid-cols-2 items-center gap-x-6 gap-y-4 px-5 pb-8 md:grid-cols-[1fr_auto_1fr] md:px-10 md:pb-[50px]">
      <span class="text-[19px] md:text-[23px]">2024</span>
      <p class="order-first col-span-2 max-w-[680px] text-center text-[14px] leading-[21px] md:order-none md:col-span-1 md:text-[17px] md:leading-[25px]">
        where you’ll uncover hidden gems and breathtaking vistas at every turn. From secluded paradises to inspiring landscapes, let us guide you to the undiscovered beauty of the world
      </p>
      <span lang="ko" class="justify-self-end text-[19px] font-light md:text-[22px]">수성못</span>
    </div>
  </div>
